NODE_ENV=development
PORT=3000

# Base de données principale PostgreSQL (Pooler ou direct)
DATABASE_URL="postgresql://user:password@localhost:5432/collecte_db"

# Connexion directe pour introspection / DDL (optionnel)
DIRECT_URL="postgresql://user:password@localhost:5432/collecte_db"

# Base de données isolée dédiée aux tests d'intégration et de concurrence réels
# ATTENTION : Ne JAMAIS pointer vers une base de production ou Supabase distant.
# Exigences : base locale/CI avec nom explicite contenant 'test' (ex: collecte_test)
DATABASE_TEST_URL="postgresql://postgres:postgres@localhost:5432/collecte_test"

# Clés secrètes JWT (À remplacer impérativement en production par des chaînes aléatoires >= 64 caractères)
JWT_ACCESS_SECRET="CHANGE_ME_SECRET_POUR_DEV_LOCAL_UNIQUEMENT_MIN_64_CHARS_0123456789ABCDEF"
JWT_REFRESH_SECRET="CHANGE_ME_REFRESH_POUR_DEV_LOCAL_UNIQUEMENT_MIN_64_CHARS_0123456789ABCDEF"

JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Clé HMAC pour la validation des webhooks fournisseurs de paiement
WEBHOOK_SECRET_KEY="test_webhook_hmac_secret_key_local"